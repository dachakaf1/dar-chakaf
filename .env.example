# Copie ce fichier en ".env" pour le dev local. NE JAMAIS pousser ".env" sur GitHub.
# Sur Vercel : Settings -> Environment Variables.

# Neon (Postgres) -> Connection string "pooled"
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Secret de connexion admin : une longue valeur aleatoire (32+ caracteres)
# Generer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Vercel Blob (ajoute automatiquement quand le Blob est connecte au projet)
BLOB_READ_WRITE_TOKEN=
